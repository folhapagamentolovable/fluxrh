  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fluxrh/contracts": "*",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.0.16"
  }
}
